# Copy this file to .env.local and fill in what you have.
# Everything is optional: without keys the app shows clearly labelled sample fares.
# Step-by-step instructions: docs/SETUP_GUIDE.md

# Recent flight prices (free, Travelpayouts / Aviasales Data API)
TRAVELPAYOUTS_TOKEN=

# Live Google Flights prices (free plan, about 250 searches a month)
SERPAPI_KEY=
# The app's own safety stop for live searches each month; keep it below SerpApi's limit
SERPAPI_MONTHLY_LIMIT=200

# AI trip planner (Phase 3, Google AI Studio free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Ratings and reviews in the city guide (Google Places API (New), 1,000 free requests a month;
# needs a billing account in a SEPARATE Google Cloud project; see SETUP_GUIDE section 7)
GOOGLE_PLACES_API_KEY=
# The app's own daily safety stop; also set Google's daily quota to 30
GOOGLE_PLACES_DAILY_LIMIT=30
