# Copy to .env.local. Everything is optional: without keys MarketMind still runs,
# using its built-in analysis engine (and labelled sample data if the internet is unreachable).

# Claude: powers Deep Research (live web search across the five market services),
# the AI market brief and the Advisor Roundtable debates.
# Get a key at https://platform.claude.com/ -> API keys
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5)
MARKETMIND_MODEL=claude-opus-5-5


# Set to 1 to force sample data (e.g. for demos on a plane)
MARKETMIND_OFFLINE=
